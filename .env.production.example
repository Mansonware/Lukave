# ──────────────────────────────────────────────────────────────
# NEXUS — Variáveis de produção (Vercel / Railway / etc.)
# NÃO commite este arquivo com valores reais.
# ──────────────────────────────────────────────────────────────

# PostgreSQL — URL com pgbouncer para runtime, URL direta para migrations
DATABASE_URL=
DIRECT_URL=

# Auth.js v5
# Gere AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_URL=

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nexus-media

# E-mail via Resend
RESEND_API_KEY=
EMAIL_FROM=NEXUS <no-reply@nexus.app>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Rate limiting via Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=https://nexus.app
