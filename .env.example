# ──────────────────────────────────────────────────────────────
# NEXUS — Variáveis de ambiente
# Copie para `.env` e preencha com seus valores reais.
# ──────────────────────────────────────────────────────────────

# PostgreSQL (Supabase, Neon, Railway, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/nexus?schema=public"
# URL direta (sem pgbouncer) para migrations, se usar pooling:
DIRECT_URL="postgresql://user:password@localhost:5432/nexus?schema=public"

# NextAuth / Auth.js v5
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OAuth opcional
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nexus-media"

# Stripe (fases 4 e 5)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# E-mail via Resend — opcional. Sem RESEND_API_KEY, o link é logado no console.
RESEND_API_KEY=""
EMAIL_FROM="NEXUS <no-reply@nexus.app>"

# Rate limiting via Upstash Redis — opcional. Sem as vars, o limite é desativado.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
