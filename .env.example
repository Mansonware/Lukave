# ──────────────────────────────────────────────────────────────
# NEXUS — Variáveis de ambiente
# Copie para `.env` e preencha com seus valores reais.
# ──────────────────────────────────────────────────────────────

# PostgreSQL (Supabase, Neon, Railway, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/nexus?schema=public"
# URL direta (sem pgbouncer) para migrations, se usar pooling:
DIRECT_URL="postgresql://user:password@localhost:5432/nexus?schema=public"

# NextAuth / Auth.js v5
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nexus-media"

# Stripe (fases 4 e 5)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# E-mail (recuperação de senha) — opcional. Sem isso, o link é logado no console.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="NEXUS <no-reply@nexus.app>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
