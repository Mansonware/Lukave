# ──────────────────────────────────────────────────────────────
# NEXUS — Variáveis de ambiente
# Copie para `.env` e preencha com seus valores reais.
# ──────────────────────────────────────────────────────────────

# PostgreSQL (Supabase, Neon, Railway, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/nexus?schema=public"
# URL direta (sem pgbouncer) para migrations, se usar pooling:
DIRECT_URL="postgresql://user:password@localhost:5432/nexus?schema=public"

# NextAuth / Auth.js v5
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OAuth opcional
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nexus-media"

# Stripe (fases 4 e 5)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# E-mail via Resend — opcional. Sem RESEND_API_KEY, o link é logado no console.
RESEND_API_KEY=""
EMAIL_FROM="NEXUS <no-reply@nexus.app>"

# Rate limiting e cache via Upstash Redis — opcional. Sem as vars, limite e cache são desativados.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 — armazenamento de mídia (fotos, vídeos, avatares, capas)
# Substitui o Supabase Storage em produção para reduzir custo de egress.
# Para criar: Cloudflare Dashboard → R2 → Create Bucket → Manage API tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nexus-media"
# URL pública do bucket (ativar em Cloudflare R2 → Settings → Public Access)
R2_PUBLIC_URL="https://cdn.nexus.app"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
