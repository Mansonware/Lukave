# ──────────────────────────────────────────────────────────────
# Lukave — Variáveis de ambiente
# Copie para `.env` e substitua pelos seus valores reais.
# ──────────────────────────────────────────────────────────────

# =============================================================
# Núcleo mínimo para subir localmente (obrigatório)
# =============================================================

# PostgreSQL
DATABASE_URL="postgresql://localhost:5432/lukave?schema=public"
# URL direta para migrations (sem pooler), quando aplicável
DIRECT_URL="postgresql://localhost:5432/lukave?schema=public"

# Auth.js / NextAuth
# Gere com: openssl rand -base64 32
AUTH_SECRET="substitua-por-um-segredo-forte"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# URL pública usada por metadados e redirecionamentos
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================
# OAuth social (opcional)
# =============================================================
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# =============================================================
# Supabase Storage (opcional, mas recomendado para uploads reais)
# =============================================================
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Identificador do bucket usado pelo app.
# Para novas instalações Lukave, use "lukave-media".
# Se seu ambiente legado já usa "nexus-media", mantenha esse valor até migrar o bucket.
SUPABASE_STORAGE_BUCKET="lukave-media"

# =============================================================
# Stripe (opcional por integração)
# - Checkout e webhook usam as variáveis abaixo
# =============================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Exemplo local de webhook:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe

# =============================================================
# E-mail com Resend (opcional)
# - Sem RESEND_API_KEY, o app faz fallback para log em desenvolvimento
# =============================================================
RESEND_API_KEY=""
EMAIL_FROM="Lukave <no-reply@lukave.app>"

# =============================================================
# Rate limiting com Upstash Redis (opcional)
# - Sem estas variáveis, limitadores ficam desativados
# =============================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
